+#ifdef __EMSCRIPTEN__
+struct RetromRangeSource
+{
+	zip_uint64_t size;
+	zip_uint64_t position = 0;
+	zip_error_t error;
+};
+
+static zip_int64_t retrom_range_source(void *userdata, void *data, zip_uint64_t length, zip_source_cmd_t command)
+{
+	RetromRangeSource *range = static_cast<RetromRangeSource *>(userdata);
+	switch (command)
+	{
+	case ZIP_SOURCE_SUPPORTS:
+		return ZIP_SOURCE_SUPPORTS_SEEKABLE;
+	case ZIP_SOURCE_OPEN:
+		range->position = 0;
+		return 0;
+	case ZIP_SOURCE_CLOSE:
+		return 0;
+	case ZIP_SOURCE_STAT:
+		if (length < sizeof(zip_stat_t))
+			break;
+		zip_stat_init(static_cast<zip_stat_t *>(data));
+		static_cast<zip_stat_t *>(data)->size = range->size;
+		static_cast<zip_stat_t *>(data)->valid = ZIP_STAT_SIZE;
+		return sizeof(zip_stat_t);
+	case ZIP_SOURCE_READ:
+	{
+		if (range->position >= range->size)
+			return 0;
+		zip_uint64_t count = range->size - range->position;
+		if (count > length) count = length;
+		if (count > 256 * 1024) count = 256 * 1024;
+		int received = retrom_flycast_range_read(static_cast<double>(range->position),
+			static_cast<unsigned>(count), data);
+		if (received != static_cast<int>(count))
+		{
+			zip_error_set(&range->error, ZIP_ER_READ, 0);
+			return -1;
+		}
+		range->position += count;
+		return received;
+	}
+	case ZIP_SOURCE_SEEK:
+	{
+		zip_int64_t position = zip_source_seek_compute_offset(range->position, range->size,
+			data, length, &range->error);
+		if (position < 0)
+			return -1;
+		range->position = static_cast<zip_uint64_t>(position);
+		return 0;
+	}
+	case ZIP_SOURCE_TELL:
+		return static_cast<zip_int64_t>(range->position);
+	case ZIP_SOURCE_ERROR:
+		return zip_error_to_data(&range->error, data, length);
+	case ZIP_SOURCE_FREE:
+		zip_error_fini(&range->error);
+		delete range;
+		return 0;
+	default:
+		break;
+	}
+	zip_error_set(&range->error, ZIP_ER_INVAL, 0);
+	return -1;
+}
+
+bool ZipArchive::OpenRange(const char *path)
+{
+	const double rangeSize = retrom_flycast_range_size(path);
+	if (rangeSize <= 0 || rangeSize > 2147483647.0)
+		return false;
+	RetromRangeSource *range = new RetromRangeSource{static_cast<zip_uint64_t>(rangeSize)};
+	zip_error_init(&range->error);
+	zip_error_t error;
+	zip_source_t *source = zip_source_function_create(retrom_range_source, range, &error);
+	if (source == nullptr)
+	{
+		zip_error_fini(&range->error);
+		delete range;
+		return false;
+	}
+	zip = zip_open_from_source(source, ZIP_RDONLY, nullptr);
+	if (zip == nullptr)
+		zip_source_free(source);
+	return zip != nullptr;
+}
