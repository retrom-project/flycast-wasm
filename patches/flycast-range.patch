 #include "oslib/storage.h"
 #include "oslib/i18n.h"
 #include <libchdr/chd.h>
+#include "../archive/retrom_flycast_range.h"
+
+#ifdef __EMSCRIPTEN__
+struct RetromCHDStream
+{
+	core_file file;
+	uint64_t size;
+	uint64_t position;
+};
+
+static uint64_t retrom_chd_size(core_file *file)
+{
+	return static_cast<RetromCHDStream *>(file->argp)->size;
+}
+
+static size_t retrom_chd_read(void *buffer, size_t elementSize, size_t count, core_file *file)
+{
+	RetromCHDStream *range = static_cast<RetromCHDStream *>(file->argp);
+	if (elementSize == 0 || count > SIZE_MAX / elementSize)
+		return 0;
+	uint64_t requested = elementSize * count;
+	if (requested > range->size - range->position)
+		requested = range->size - range->position;
+	uint64_t received = 0;
+	while (received < requested)
+	{
+		unsigned length = static_cast<unsigned>(std::min<uint64_t>(requested - received, 256 * 1024));
+		int got = retrom_flycast_range_read(static_cast<double>(range->position), length,
+			static_cast<unsigned char *>(buffer) + received);
+		if (got != static_cast<int>(length))
+			break;
+		range->position += length;
+		received += length;
+	}
+	return received / elementSize;
+}
+
+static int retrom_chd_seek(core_file *file, int64_t offset, int origin)
+{
+	RetromCHDStream *range = static_cast<RetromCHDStream *>(file->argp);
+	int64_t base = origin == SEEK_SET ? 0 : origin == SEEK_CUR ? range->position :
+		origin == SEEK_END ? range->size : -1;
+	if (base < 0 || offset < -base || offset > static_cast<int64_t>(range->size) - base)
+		return -1;
+	range->position = base + offset;
+	return 0;
+}
+
+static int retrom_chd_close(core_file *file)
+{
+	delete static_cast<RetromCHDStream *>(file->argp);
+	return 0;
+}
+
+static chd_error retrom_chd_open(uint64_t size, chd_file **chd)
+{
+	RetromCHDStream *range = new RetromCHDStream{};
+	range->size = size;
+	range->file = {range, retrom_chd_size, retrom_chd_read, retrom_chd_close, retrom_chd_seek};
+	return chd_open_core_file(&range->file, CHD_OPEN_READ, nullptr, chd);
+}
+#endif
 
